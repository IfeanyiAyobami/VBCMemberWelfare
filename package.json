{
  "name": "vbc-member-care-frontend",
  "version": "0.7.5.1",
  "private": true,
  "type": "module",
  "description": "Vine Branch Church care dashboard \u2014 First-Timer Gateway v1.1.3 integration",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test:auth": "npm run build && node tests/auth-integration.mjs",
    "test:auth:dev": "node tests/auth-integration.mjs --dev",
    "test:members": "node --experimental-strip-types tests/member-validation.mjs",
    "preview:html": "node tools/build-preview.mjs",
    "test": "npm run preview:html && node tests/member-care.cjs && node tests/email-designs.cjs && node tests/theme.cjs && npm run test:members",
    "format": "prettier --write src tools tests",
    "test:care-db": "node tests/care-database.mjs",
    "test:guest-db": "node tests/guest-database.mjs",
    "test:gateway": "node --experimental-strip-types --loader ./tests/resolve-ts.mjs tests/gateway-validation.mjs",
    "test:gateway-db": "node tests/gateway-database.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "css-tree": "^3.1.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3"
  }
}
