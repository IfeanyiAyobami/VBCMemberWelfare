# Project configuration. Values prefixed NEXT_PUBLIC_ are browser-safe. Copy this file to .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_this
# Member Care uses publishable details; Home Cell server routes additionally require:
SUPABASE_SERVICE_ROLE_KEY=
# Optional separate random secret (32+ bytes) for hashed rate-limit buckets.
# Falls back to service-role key. Rotating either resets relevant throttles.
HCO_RATE_LIMIT_SECRET=

# Working First-Timer Gateway v1.1.3 receiver. Enable after SQL 006 is installed.
# Never prefix these secrets with NEXT_PUBLIC_. Generate a 64-character random token.
VBC_MEMBER_CARE_GATEWAY_ENABLED=false
VBC_MEMBER_CARE_GATEWAY_TOKEN=
SUPABASE_SECRET_KEY=

# Legacy v0.6.0 HMAC bridge only. The working Gateway does NOT use this route.
# Keep disabled; do not install its plugin or replace the existing Elementor form.
VBC_GUEST_BRIDGE_ENABLED=false
VBC_WORDPRESS_BRIDGE_SECRET=

